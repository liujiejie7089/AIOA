# AIOA agent 模型接入配置模板
# 用法：复制本文件为 agent/.env 并填入真实 key，重启 agent 即生效。
# .env 已被 gitignore，key 不会入库；已有环境变量优先于 .env。

# ---- 模型路由 ----
# 默认 provider：echo | deepseek | dashscope | vllm | ollama
# 配置了对应 key 后建议改为 deepseek（未配 key 会自动降级 echo）
MODEL_DEFAULT=echo

# ---- DeepSeek 开放平台 ----
# 申请：https://platform.deepseek.com -> API Keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 阿里云百炼/通义（OpenAI 兼容模式）----
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# ---- 本地私有化（vLLM / Ollama）----
# VLLM_BASE_URL=http://127.0.0.1:8001/v1
# VLLM_MODEL=Qwen2.5-7B-Instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---- 服务 ----
# HOST=0.0.0.0
# PORT=8000
