# AIOA agent 模块配置模板
# 用法：复制本文件为 agent/.env 并填入真实 key，重启 agent 即生效。
# 优先级：已存在的环境变量 > .env > 代码默认值。
# .env 已被 gitignore，key 不会入库。

# ---- 模型路由 ----
# 默认 provider：echo | deepseek | dashscope | vllm | ollama
# 隐式默认解析到未配 key 的云端 provider 时会自动降级 echo（保证链路可用）
MODEL_DEFAULT=echo

# ---- DeepSeek 开放平台 ----
# 申请：https://platform.deepseek.com -> API Keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云百炼/通义（OpenAI 兼容模式）----
# 申请：https://bailian.console.aliyun.com -> API-KEY
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# ---- 本地私有化（vLLM / Ollama）----
# VLLM_BASE_URL=http://127.0.0.1:8001/v1
# VLLM_MODEL=Qwen2.5-7B-Instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---- 服务间调用 ----
# Java 业务后端地址（agent 回调 tools/invoke、runs 上报使用）
# AIOA_SERVER_BASE_URL=http://127.0.0.1:8080

# ---- 服务监听 ----
# HOST=0.0.0.0
# PORT=8000
