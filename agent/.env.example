# AIOS agent 模块配置模板
# 用法：复制本文件为 agent/.env 并填入真实 key，重启 agent 即生效。
# 优先级：已存在的环境变量 > .env > 代码默认值。
# .env 已被 gitignore，key 不会入库。

# ---- 模型路由 ----
# 默认 provider：echo | deepseek | dashscope | vllm | ollama
# 隐式默认解析到未配 key 的云端 provider 时会自动降级 echo（保证链路可用）
MODEL_DEFAULT=echo

# ---- DeepSeek 开放平台 ----
# 申请：https://platform.deepseek.com -> API Keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 阿里云百炼/通义（OpenAI 兼容模式）----
# 申请：https://bailian.console.aliyun.com -> API-KEY
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# ---- 本地私有化（vLLM / Ollama）----
# VLLM_BASE_URL=http://127.0.0.1:8001/v1
# VLLM_MODEL=Qwen2.5-7B-Instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---- 服务间调用 ----
# Java 业务后端地址（agent 回调 tools/invoke、runs 上报使用）
# AIOS_SERVER_BASE_URL=http://127.0.0.1:8080

# ---- 服务监听 ----
# HOST=0.0.0.0
# PORT=8000

# ---- HITL（人工介入：ask_user 澄清 + request_form 自定义表单）----
# 默认 false。为 false 时两个内置工具**不进模型工具表**，数字人只会输出「操作步骤」
# 文字，永远不弹自定义表单 —— 这就是「数字人不调用自定义表单」的根因，别再往提示词里找。
# 本地开发务必开：AIOS_HITL=true
# 部署侧（compose / k8s）必须显式透传，因为 .env 被 .dockerignore 排除、进不了镜像。
# 验：agent 日志 `tools=9` 表示已注入（为 7 即未生效）。
# AIOS_HITL=true
#
# 挂起态存储。留空 = 进程内存（重启即丢，用户回填会「无法恢复」）。
# 生产给 Redis Stack 或 sqlite：
# AIOS_CHECKPOINT_URL=redis://127.0.0.1:6379/0
# AIOS_CHECKPOINT_URL=sqlite:///./.hitl.sqlite

# ---- 服务间令牌（Java ⇄ agent）----
# /internal/v1/* 自 2026-10-18 起强制校验此密钥（HS256）。变量名就是
# **SERVICE_JWT_SECRET**（不带 AIOS_ 前缀 —— Java 侧读的是 AIOS_SERVICE_JWT_SECRET，两者同值）。
# 不填则用开发占位串，与 Java 默认值一致所以本地能跑；一旦任一端改成真密钥而另一端没改，
# 症状是「全部 /internal/v1/* 401」，且 Java 侧往往**静默降级**（意图识别变笨）而非报错。
# 排查入口：agent 启动日志 `service jwt ready: fingerprint=xxxxxxxx dev_placeholder=true|false`。
# SERVICE_JWT_SECRET=change-me-service-secret-at-least-32-bytes

# ---- 语音输入（ASR，离线）----
# H5 的「长按说话」把音频原始字节发给 Java（/api/v1/asr/transcribe），
# Java 再转发到本服务的 /internal/v1/asr/transcribe 识别成文字。
#
# 模型查找顺序：AIOS_ASR_MODEL 是目录就直接用 → 否则看 <AIOS_ASR_MODEL_DIR>/<名字>
# 是否存在（含 model.bin）→ 都没有才按名字走 HuggingFace 下载。
# 离线落地的最简做法：把 faster-whisper 模型摊平到 agent/.models/small/
# （model.bin + config.json + tokenizer.json + vocabulary.txt），本组变量一个都不用设。
#
# AIOS_ASR_MODEL=small                  # 模型名或模型目录绝对路径
# AIOS_ASR_MODEL_DIR=./.models          # 默认 agent/.models
# AIOS_ASR_DEVICE=cpu                   # cpu | cuda
# AIOS_ASR_COMPUTE_TYPE=int8            # int8 最省内存；有 GPU 可 float16
# AIOS_ASR_MAX_BYTES=10485760           # 单次音频上限（须与 Java 侧 aios.asr.max-bytes 一致）
# AIOS_ASR_MAX_SECONDS=60               # 单次音频时长上限
# AIOS_ASR_ALLOW_DOWNLOAD=0             # 1 = 允许从 HF 下载（内网/生产保持 0）
#
# 内网无法直连 huggingface.co 时，下载模型可走镜像：
#   HF_ENDPOINT=https://hf-mirror.com HF_HUB_DISABLE_XET=1 pip download 后的模型放上述目录
#   （hf-xet 走 cas-server.xethub.hf.co，该域通常也被墙，故必须关掉 Xet）
