# AIOA 前端（shell + 示例子应用，pnpm workspace 构建，nginx 托管）
FROM node:22-alpine AS build
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY web/pnpm-workspace.yaml web/package.json web/pnpm-lock.yaml* ./
# ★ 必须 COPY 根 tsconfig：apps/*/tsconfig.json 与 packages/aioa-sdk/tsconfig.json 都
#    `extends: "../../tsconfig.base.json"`，容器里即 /build/tsconfig.base.json。
#   漏了它 ⇒ vue-tsc 拿不到 strict / esModuleInterop / moduleResolution:bundler / skipLibCheck，
#   报的却不是「文件找不到」，而是一堆 element-plus 与 rollup/parseAst 的下游错误，极难定位。
COPY web/tsconfig.base.json ./
COPY web/packages ./packages
COPY web/apps ./apps
# 先尝试严格模式（lockfile 一致才构建）；fallback 显式放宽而非静默改 lockfile
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile
RUN pnpm -r build

FROM nginx:1.27-alpine
# shell 主应用托管在 /，子应用托管在 /subapps/<name>/
COPY --from=build /build/apps/shell/dist /usr/share/nginx/html
COPY --from=build /build/apps/demo-ticket/dist /usr/share/nginx/html/subapps/demo-ticket
COPY --from=build /build/apps/demo-dispatch/dist /usr/share/nginx/html/subapps/demo-dispatch
COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80