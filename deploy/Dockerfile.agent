# AIOA Python agent 服务
FROM python:3.13-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
# ★ 必须同时拷 aioa_ai：AI 能力（图/工具/提示词/检索）全在 aioa_ai，app/ 只是 HTTP 接入层。
#   只拷 app 时容器内 `from aioa_ai import entry` 直接 ModuleNotFoundError，agent 起不来。
#   pyproject 的 packages.find 也已改成 ["app*", "aioa_ai*"]，两处是双保险：
#   pip 装进 site-packages 一份，cwd(/app) 下再放一份，任一条路径失效都不至于起不来。
COPY aioa_ai ./aioa_ai
COPY app ./app
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .
EXPOSE 8000
ENV PYTHONUNBUFFERED=1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
