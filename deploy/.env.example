# ==============================================================================
# ⚠️ 本文件已被以下两份取代，仅为兼容旧引用而保留（勿再往这里加变量）：
#     deploy/.env.development   本地开发（键序与生产完全一致）
#     deploy/.env.production    生产
#     对照表见 deploy/ENV.md
#   下面是历史单文件模板的内容，可能已滞后。
#   ⚠️ 2026-09-21 起（docs/33「单端口部署改造」）：入口已由「边缘 nginx 双端口」改为
#      **aios-server 单端口 8080**（/aios/h5、/aios/web、/aios/api）；compose 里
#      nginx / ollama / aios-web 三个服务与 ollamadata 卷均已摘除。本历史模板不再反映该变更。
# ==============================================================================

# ---- 数据库（MySQL 8，已迁至 192.168.31.129）----
MYSQL_DB=aios
MYSQL_HOST=192.168.31.129
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yjiud

# ---- Redis（与 MySQL 同主机，也可单独配置）----
REDIS_HOST=192.168.31.129
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- MinIO ----
MINIO_ROOT_USER=aios
MINIO_ROOT_PASSWORD=change-me-minio-pwd

# ---- JWT 密钥（生产必须更换，禁止入库/入镜像）----
# 长度 ≥ 32 字节；用 `openssl rand -base64 48` 生成
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
SERVICE_JWT_SECRET=change-me-service-secret-at-least-32-bytes

# ---- 模型（双模式：云端 echo/qwen-plus/deepseek-chat；本地 local-vllm/local-ollama）----
# M1 骨架用 echo（内置回声，不依赖外部模型）
MODEL_DEFAULT=echo
# 云端（二选一或都配）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# 本地（docker compose --profile model up -d 后生效）
LOCAL_VLLM_BASE_URL=http://vllm:8000/v1
OLLAMA_BASE_URL=                              # 【已摘除】compose 不再有 ollama 服务；留空（选中该 provider 会降级 echo）
LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ---- 观测（profile=ops）----
GRAFANA_ADMIN_PASSWORD=admin

# ====================================================================
# 代码托管方（Gitee 或 Gitea）
# 切到 Gitea：AIOS_REPO_PROVIDER=gitea 并填下方 GITEA_* 段
# ====================================================================
AIOS_REPO_PROVIDER=gitee

# ---- Gitee 段（aios.repo.provider=gitee 时生效）----
AIOS_GITEE_ENABLED=true
# 服务端 API 基址（私有化部署改成 https://your-gitee.example.com/api/v5）
AIOS_GITEE_BASE_URL=https://gitee.com/api/v5
AIOS_GITEE_WEB_URL=https://gitee.com
# 用户浏览器授权页基址（默认与 web-base-url 同；接桩做端到端回归时才需要改成桩域）
AIOS_GITEE_OAUTH_AUTHORIZE_URL=https://gitee.com
# OAuth2 应用（在 Gitee「设置 → 第三方应用」创建；回调地址必须与下方 redirect-uri 完全一致）
AIOS_GITEE_CLIENT_ID=
AIOS_GITEE_CLIENT_SECRET=
# 生产必须改成公网域名，例如 https://aios.example.com/api/v1/gitee/bind/callback
AIOS_GITEE_REDIRECT_URI=http://localhost/api/v1/gitee/bind/callback
# 授权 scope：必须同时含 projects（仓库读写）和 hook（Webhook 读写），二者是 Gitee 独立 scope
AIOS_GITEE_SCOPE="user_info projects hook pull_requests issues notes"
# Gitee 组织 login：部门项目仓库都建在它下面；留空则建在绑定用户自己的命名空间下
AIOS_GITEE_ORG=
# Webhook 回调基址：必须是 Gitee 能访问到的公网地址（127.0.0.1 / 内网 IP 无效）
AIOS_GITEE_WEBHOOK_BASE_URL=
# 留空 = 每个仓库随机生成密钥（推荐）；填了则所有仓库共用同一密钥
AIOS_GITEE_WEBHOOK_SECRET=
# 令牌加密密钥（AES-256，≥ 32 字节）：生产必须填，否则授权令牌可被离线解密
AIOS_GITEE_TOKEN_ENC_KEY=
# 授权完成后的前端回跳地址（生产改成前端公网域名）
AIOS_GITEE_BIND_RETURN_URL=http://localhost/

# ---- Gitea 段（仅当 AIOS_REPO_PROVIDER=gitea 时生效）----
AIOS_GITEA_ENABLED=false
# REST 基址：必须带 /api/v1
AIOS_GITEA_BASE_URL=
AIOS_GITEA_WEB_URL=
AIOS_GITEA_OAUTH_AUTHORIZE_URL=
AIOS_GITEA_CLIENT_ID=
AIOS_GITEA_CLIENT_SECRET=
AIOS_GITEA_REDIRECT_URI=http://localhost/api/v1/gitea/bind/callback
# scope 词表与 Gitee 不同：repo / read:organization / notification / issue …
# ⚠️ 含空格的值必须加双引号，否则 `set -a && . .env` 会把空格当分词 ⇒ 整份文件解析中断
AIOS_GITEA_SCOPE="repo read:organization notification issue"
AIOS_GITEA_ORG=
AIOS_GITEA_WEBHOOK_BASE_URL=
AIOS_GITEA_WEBHOOK_SECRET=
AIOS_GITEA_TOKEN_ENC_KEY=
# 仓库标识来源：AUTO / NAME / PATH
AIOS_GITEA_REPO_NAME_SOURCE=AUTO

# ---- 知识库存储 ----
# mysql（默认，切片 + 向量 BLOB 全在 MySQL）/ milvus（向量库，见下方 §Milvus）
# ⚠️ 改成 milvus 时 Milvus 必须在线，否则后端**启动失败**（决策 D6 fail-fast，不静默降级）
AIOS_KB_STORE=mysql
# 嵌入 provider：local（256 维 n-gram 哈希，零依赖但无语义）| http（语义向量）
# 换 provider / 模型后必须跑一次 AIOS_KB_REEMBED_ON_START=true 重算历史向量
AIOS_KB_EMBEDDING_PROVIDER=local
AIOS_KB_REEMBED_ON_START=false
AIOS_KB_EMBEDDING_FORMAT=ollama
AIOS_KB_EMBEDDING_URL=
AIOS_KB_EMBEDDING_MODEL=bge-small-zh-v1.5
AIOS_KB_EMBEDDING_DIMS=512
AIOS_KB_EMBEDDING_TIMEOUT_MS=15000
AIOS_KB_EMBEDDING_API_KEY=

# ---- Milvus 向量库（仅 AIOS_KB_STORE=milvus 时读取）----
# 起栈：AIOS_KB_STORE=milvus docker compose --profile milvus up -d
AIOS_MILVUS_URI=http://127.0.0.1:19530
AIOS_MILVUS_TOKEN=
AIOS_MILVUS_DATABASE=default
# 集合名带版本后缀：换嵌入模型要新建集合（如 kb_chunk_v2）再回填
AIOS_MILVUS_COLLECTION=kb_chunk_v1
AIOS_MILVUS_DIMS=512
AIOS_MILVUS_METRIC=COSINE
AIOS_MILVUS_INDEX=HNSW
AIOS_MILVUS_HNSW_M=16
AIOS_MILVUS_HNSW_EF=200
AIOS_MILVUS_ENABLE_BM25=true
AIOS_MILVUS_BACKFILL=false
AIOS_MILVUS_TIMEOUT_MS=10000
AIOS_MILVUS_BATCH=200
MILVUS_IMAGE_TAG=v2.5.3

# ---- 公共服务 URL（公网部署时改成实际域名）----
# 【已改单端口，docs/33】入口 = http://<host>:8080/aios/（不再是 nginx 的 80/81）；
# OAuth 回调、绑定完成回跳都以它（含 :8080 端口）为基准
PUBLIC_BASE_URL=http://localhost:8080