# ---- 数据库（MySQL 8，已迁至 192.168.31.129）----
MYSQL_DB=aioa
MYSQL_HOST=192.168.31.129
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yjiud

# ---- Redis（与 MySQL 同主机，也可单独配置）----
REDIS_HOST=192.168.31.129
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- MinIO ----
MINIO_ROOT_USER=aioa
MINIO_ROOT_PASSWORD=change-me-minio-pwd

# ---- JWT 密钥（生产必须更换，禁止入库/入镜像）----
# 长度 ≥ 32 字节；用 `openssl rand -base64 48` 生成
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
SERVICE_JWT_SECRET=change-me-service-secret-at-least-32-bytes

# ---- 模型（双模式：云端 echo/qwen-plus/deepseek-chat；本地 local-vllm/local-ollama）----
# M1 骨架用 echo（内置回声，不依赖外部模型）
MODEL_DEFAULT=echo
# 云端（二选一或都配）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# 本地（docker compose --profile model up -d 后生效）
LOCAL_VLLM_BASE_URL=http://vllm:8000/v1
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ---- 观测（profile=ops）----
GRAFANA_ADMIN_PASSWORD=admin

# ====================================================================
# 代码托管方（Gitee 或 Gitea）
# 切到 Gitea：AIOA_REPO_PROVIDER=gitea 并填下方 GITEA_* 段
# ====================================================================
AIOA_REPO_PROVIDER=gitee

# ---- Gitee 段（aioa.repo.provider=gitee 时生效）----
AIOA_GITEE_ENABLED=true
# 服务端 API 基址（私有化部署改成 https://your-gitee.example.com/api/v5）
AIOA_GITEE_BASE_URL=https://gitee.com/api/v5
AIOA_GITEE_WEB_URL=https://gitee.com
# 用户浏览器授权页基址（默认与 web-base-url 同；接桩做端到端回归时才需要改成桩域）
AIOA_GITEE_OAUTH_AUTHORIZE_URL=https://gitee.com
# OAuth2 应用（在 Gitee「设置 → 第三方应用」创建；回调地址必须与下方 redirect-uri 完全一致）
AIOA_GITEE_CLIENT_ID=
AIOA_GITEE_CLIENT_SECRET=
# 生产必须改成公网域名，例如 https://aioa.example.com/api/v1/gitee/bind/callback
AIOA_GITEE_REDIRECT_URI=http://localhost/api/v1/gitee/bind/callback
# 授权 scope：必须同时含 projects（仓库读写）和 hook（Webhook 读写），二者是 Gitee 独立 scope
AIOA_GITEE_SCOPE=user_info projects hook pull_requests issues notes
# Gitee 组织 login：部门项目仓库都建在它下面；留空则建在绑定用户自己的命名空间下
AIOA_GITEE_ORG=
# Webhook 回调基址：必须是 Gitee 能访问到的公网地址（127.0.0.1 / 内网 IP 无效）
AIOA_GITEE_WEBHOOK_BASE_URL=
# 留空 = 每个仓库随机生成密钥（推荐）；填了则所有仓库共用同一密钥
AIOA_GITEE_WEBHOOK_SECRET=
# 令牌加密密钥（AES-256，≥ 32 字节）：生产必须填，否则授权令牌可被离线解密
AIOA_GITEE_TOKEN_ENC_KEY=
# 授权完成后的前端回跳地址（生产改成前端公网域名）
AIOA_GITEE_BIND_RETURN_URL=http://localhost/

# ---- Gitea 段（仅当 AIOA_REPO_PROVIDER=gitea 时生效）----
AIOA_GITEA_ENABLED=false
# REST 基址：必须带 /api/v1
AIOA_GITEA_BASE_URL=
AIOA_GITEA_WEB_URL=
AIOA_GITEA_OAUTH_AUTHORIZE_URL=
AIOA_GITEA_CLIENT_ID=
AIOA_GITEA_CLIENT_SECRET=
AIOA_GITEA_REDIRECT_URI=http://localhost/api/v1/gitea/bind/callback
# scope 词表与 Gitee 不同：repo / read:organization / notification / issue …
AIOA_GITEA_SCOPE=repo read:organization notification issue
AIOA_GITEA_ORG=
AIOA_GITEA_WEBHOOK_BASE_URL=
AIOA_GITEA_WEBHOOK_SECRET=
AIOA_GITEA_TOKEN_ENC_KEY=
# 仓库标识来源：AUTO / NAME / PATH
AIOA_GITEA_REPO_NAME_SOURCE=AUTO

# ---- 知识库存储 ----
AIOA_KB_STORE=mysql

# ---- 公共服务 URL（公网部署时改成实际域名）----
# 这是 Nginx 暴露给用户的入口；OAuth 回调、绑定完成回跳都以它为基准
PUBLIC_BASE_URL=http://localhost