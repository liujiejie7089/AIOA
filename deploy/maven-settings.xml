<?xml version="1.0" encoding="UTF-8"?>
<!--
  AIOA 构建期 Maven 设置（由 deploy/Dockerfile.server COPY 到镜像内 /root/.m2/settings.xml）。

  只做一件事：把默认的 **central**（repo.maven.apache.org）重定向到阿里云公共仓库。
  应用机常常「能上百度/阿里云，但到 Maven Central 极慢或不通」，这份文件让构建只依赖国内镜像。

  ⚠️ 刻意**不用** <mirrorOf>*</mirrorOf>：写 `*` 会把所有仓库（含插件仓库）一并改写，
     镜像一旦缺件就整体失败，且报错是「找不到某个 jar」，很难联想到是镜像的问题。
     只改写 central ⇒ 其余仓库仍走原地址，失败面最小。

  要换成内网 nexus（如 http://172.16.8.x:8081/repository/maven-public/）：
  只改下面这一行 <url>，然后重新 `docker compose build server` 即可。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun Public (mirror of central)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
