# ==============================================================================
# AIOA · 本地开发环境变量  （deploy/.env.development）
# ------------------------------------------------------------------------------
# 用途：本机（单机）跑全栈——Java 后端 :8080 / Python agent :8000 / H5 :5181 /
#       管理端 :5173-5175。全部指向 127.0.0.1，无 TLS、无公网、无真实外部凭据。
#
# 用法（shell 加载式，与 start-all.sh / 手工启动一致）：
#     cd <repo 根>
#     set -a && . deploy/.env.development && set +a
#     bash start-all.sh
#   或：cp deploy/.env.development .env    （.env 已被 gitignore，放你的真实值）
#
# 【占位约定 —— 两份文件共用】
#   CHANGE_ME__xxx  必须替换的敏感值（密钥/密码/凭据），本文件里一律为占位
#   DEV_ONLY__xxx   仅允许本地使用、绝不可进生产的值
#   <xxx>           按实际环境填写的非敏感值
#   （留空）         该能力未启用，代码走内置默认
#   ▸ 生成密钥：openssl rand -base64 48
#
# 【写法纪律】含空格 / & / < > | * 的值**必须加双引号**，否则 shell 会把它们
#   当运算符（`&` = 后台、`<` = 重定向、空格 = 分词）⇒ 整份文件解析失败。
#   本文件已全部加引号；docker compose --env-file 同样能正确剥引号。
#
# 【纪律】本文件只放占位值 / 本地值，**禁止**写入任何真实生产凭据。
# ==============================================================================

# ------------------------------------------------------------------------------
# 0 · 运行档位
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
AIOA_KB_STORE=mysql                 # 知识库存储：mysql（默认，零依赖）| milvus（见 §7，需 Milvus 在线否则启动失败）
AIOA_REPO_PROVIDER=gitee            # 代码托管方：gitee | gitea

# ------------------------------------------------------------------------------
# 1 · 数据库 MySQL 8
#     SPRING_* 是 Java 后端直读项；MYSQL_* 供 docker compose 起库与拼连接串
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/aioa?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&createDatabaseIfNotExist=true"
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=        # 本机 root 无密码
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=aioa
MYSQL_USER=root
MYSQL_PASSWORD=                    # 与上方 SPRING_DATASOURCE_PASSWORD 保持一致
MYSQL_ROOT_PASSWORD=DEV_ONLY__local-root
MYSQL_DATABASE=aioa

# ------------------------------------------------------------------------------
# 2 · Redis
# ------------------------------------------------------------------------------
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=             # 本地默认无密码
SPRING_REDIS_DATABASE=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3 · 鉴权密钥  ★敏感
#     AIOA_* 给 Java 后端；无前缀的 JWT_SECRET/SERVICE_JWT_SECRET 给 compose
#     ★两端必须同值，否则后端签发的令牌 agent 验不过（表现为 401）
# ------------------------------------------------------------------------------
AIOA_JWT_SECRET=DEV_ONLY__aioa-local-jwt-secret-32bytes-min-do-not-use-in-prod
AIOA_SERVICE_JWT_SECRET=DEV_ONLY__aioa-local-service-secret-32bytes-do-not-use-in-prod
JWT_SECRET=DEV_ONLY__aioa-local-jwt-secret-32bytes-min-do-not-use-in-prod
SERVICE_JWT_SECRET=DEV_ONLY__aioa-local-service-secret-32bytes-do-not-use-in-prod

# ------------------------------------------------------------------------------
# 4 · 服务地址与运行参数
# ------------------------------------------------------------------------------
AIOA_AGENT_BASE_URL=http://127.0.0.1:8000    # 后端 → agent
AIOA_SERVER_BASE_URL=http://127.0.0.1:8080   # agent → 后端
PUBLIC_BASE_URL=http://localhost:8080        # 单端口入口（docs/33）：http://localhost:8080/aioa/h5/ 与 /aioa/web/
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
AGENT_STREAM=true
AGENT_PARALLEL_TOOLS=true
AGENT_MAX_CONCURRENCY=4
PG_DSN=                                      # 未使用（agent 默认不直连库）

# ---- 4.1 单端口入口前缀与静态托管（docs/33）----
#     本地用 compose 起 server 时，镜像内已有 /app/h5 与 /app/web，无需额外挂载。
AIOA_WEB_ENABLED=true            # false = /aioa/** 全部 404
AIOA_WEB_PREFIX=/aioa            # 对外前缀；接口 = /aioa/api/**
AIOA_WEB_H5_DIR=/app/h5          # 用户端 H5 静态目录（镜像内）
AIOA_WEB_WEB_DIR=/app/web        # 管理端 dist 目录（镜像内）

# ------------------------------------------------------------------------------
# 5 · 模型 ★敏感（云端 Key）
#     MODEL_DEFAULT 取值 = 模型网关注册表的 **key**（不是模型名）：
#       echo（内置回声，零依赖）| deepseek | dashscope | vllm | ollama
#     ⚠️ 选了 deepseek/dashscope/vllm/ollama 但对应对 *API_KEY 留空 ⇒ 网关**静默降级 echo**
#        （不报错），现象是「明明配了模型，回答却一直是回声」。本地 vLLM/Ollama 无鉴权时
#        也要给个**非空占位**（如 `ollama`）。基址必须是 OpenAI 兼容基址（**要带 /v1**）。
# ------------------------------------------------------------------------------
MODEL_DEFAULT=minimax                           # 系统默认模型（与管理端「模型管理」的 is_default 保持一致）
DASHSCOPE_API_KEY=                              # 留空即不启用通义
DEEPSEEK_API_KEY=                               # 留空即不启用 DeepSeek
MINIMAX_API_KEY=                                # 留空即不启用 MiniMax（网关会静默降级 echo）
VLLM_BASE_URL=http://127.0.0.1:8000/v1          # 本地 vLLM（compose --profile model）
VLLM_API_KEY=                                   # 无鉴权也给非空占位，否则降级 echo
OLLAMA_BASE_URL=                                # 本环境不部署 Ollama（模型走云端 Key）⇒ 留空；该 provider 选中时会降级 echo
OLLAMA_API_KEY=                                 # 同上：非空占位，否则降级 echo
LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ------------------------------------------------------------------------------
# 6 · 代码托管方
#     AIOA_REPO_PROVIDER=gitee 时只读 Gitee 段；=gitea 时只读 Gitea 段。
#     本地端到端回归想指向桩 :8090：AIOA_GITEE_E2E=1 bash start-all.sh
#     （内部 source scripts/gitee-e2e-env.sh，别手抄这几个域名）
# ------------------------------------------------------------------------------
# ---- Gitee 段 ----
AIOA_GITEE_ENABLED=true
AIOA_GITEE_BASE_URL=https://gitee.com/api/v5
AIOA_GITEE_WEB_URL=https://gitee.com
AIOA_GITEE_OAUTH_AUTHORIZE_URL=https://gitee.com
AIOA_GITEE_CLIENT_ID=                           # Gitee「设置→第三方应用」创建后填
AIOA_GITEE_CLIENT_SECRET=
AIOA_GITEE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/gitee/bind/callback
AIOA_GITEE_SCOPE="user_info projects hook pull_requests issues notes"
AIOA_GITEE_ORG=                                 # 留空=建在绑定用户命名空间下
AIOA_GITEE_WEBHOOK_BASE_URL=                    # ★必须公网可达；本地留空=Webhook 静默失效
AIOA_GITEE_WEBHOOK_SECRET=                      # 留空=每仓库随机生成（推荐）
AIOA_GITEE_TOKEN_ENC_KEY=DEV_ONLY__aioa-dev-gitee-token-key-please-change
AIOA_GITEE_BIND_RETURN_URL=http://localhost:5173/
AIOA_GITEE_SYNC_ENABLED=true
AIOA_GITEE_SYNC_CRON="0 17 * * * *"

# ---- Gitea 段 ----
AIOA_GITEA_ENABLED=false
AIOA_GITEA_BASE_URL=                            # ★必须带 /api/v1
AIOA_GITEA_WEB_URL=
AIOA_GITEA_OAUTH_AUTHORIZE_URL=
AIOA_GITEA_CLIENT_ID=
AIOA_GITEA_CLIENT_SECRET=
AIOA_GITEA_REDIRECT_URI=http://127.0.0.1:8080/api/v1/gitea/bind/callback
AIOA_GITEA_SCOPE="repo read:organization notification issue"
AIOA_GITEA_ORG=
AIOA_GITEA_WEBHOOK_BASE_URL=
AIOA_GITEA_WEBHOOK_SECRET=
AIOA_GITEA_TOKEN_ENC_KEY=DEV_ONLY__aioa-dev-gitea-token-key-please-change
AIOA_GITEA_REPO_NAME_SOURCE=AUTO
AIOA_GITEA_INSECURE_SKIP_VERIFY=false
AIOA_GITEA_TRUST_STORE=
AIOA_GITEA_TRUST_STORE_PASSWORD=
AIOA_GITEA_TRUST_STORE_TYPE=PKCS12

# ------------------------------------------------------------------------------
# 7 · 知识库 / 向量库（docs/32）
#     存储实现由 §0 的 AIOA_KB_STORE 切换：mysql（切片+向量 BLOB）| milvus（向量库）。
#     ⚠️ store=milvus 时 Milvus 必须在线，否则后端**启动失败**（决策 D6 fail-fast，不静默降级）。
#     开发机没有 Milvus 就跑默认的 mysql；要试 milvus 见 §7.1。
# ------------------------------------------------------------------------------
# ---- 7.0 嵌入 provider（两种存储都能用；换 provider 后必须重算历史向量）----
AIOA_KB_EMBEDDING_PROVIDER=local    # local（256 维 n-gram 哈希，零依赖、无语义）| http（语义向量）
AIOA_KB_REEMBED_ON_START=false      # true=启动时全量重算切片向量（换 provider/模型后跑一次，跑完改回）
AIOA_KB_EMBEDDING_DIMS=256          # ★provider=local 的输出维度写死 256，调本键无效 ⇒ 若要切 http 档：本键、AIOA_MILVUS_DIMS、集合名三者一起改
AIOA_KB_EMBEDDING_FORMAT=ollama     # 值=要对接的嵌入**接口形态**（ollama 的 /api/embeddings 或 /api/embed | openai 的 /v1/embeddings），不代表要部署 Ollama
AIOA_KB_EMBEDDING_URL=              # provider=http 时必填（例 http://127.0.0.1:11434/api/embeddings）；provider=local 时不读
AIOA_KB_EMBEDDING_MODEL=bge-small-zh-v1.5   # provider=http 时用；provider=local 时不读
AIOA_KB_EMBEDDING_TIMEOUT_MS=15000
AIOA_KB_EMBEDDING_API_KEY=          # 可选 Bearer（vLLM 网关常需）

# ---- 7.1 Milvus（仅 AIOA_KB_STORE=milvus 时读取）----
#     本地起 Milvus：AIOA_KB_STORE=milvus docker compose --profile milvus up -d
#     WebUI/健康检查：http://127.0.0.1:9091/webui/ · http://127.0.0.1:9091/healthz
AIOA_MILVUS_URI=http://127.0.0.1:19530
AIOA_MILVUS_TOKEN=                  # Milvus 未开鉴权时留空
AIOA_MILVUS_DATABASE=default
AIOA_MILVUS_COLLECTION=kb_chunk_v1_256  # 名字带维度：集合维度创建后不可改，换嵌入模型必须换名再回填
AIOA_MILVUS_DIMS=256                # 与 provider=local 的 256 维对齐（见 7.0 的 ★）
AIOA_MILVUS_METRIC=COSINE           # COSINE | IP | L2
AIOA_MILVUS_INDEX=HNSW              # HNSW | AUTOINDEX | FLAT
AIOA_MILVUS_HNSW_M=16
AIOA_MILVUS_HNSW_EF=200
AIOA_MILVUS_ENABLE_BM25=true        # 原生 BM25（需 Milvus>=2.5）；建集合失败会自动退回纯稠密并告警
AIOA_MILVUS_BACKFILL=false          # true=启动时从 kb_chunk 全量回填（首次接入/索引重建，跑完改回）
AIOA_MILVUS_TIMEOUT_MS=10000
AIOA_MILVUS_BATCH=200               # 回填与 upsert 的批量大小
MILVUS_IMAGE_TAG=v2.5.3             # 仅供 compose 拉镜像；升 2.6.x 改这里（注意集合是否需重建）

# ------------------------------------------------------------------------------
# 8 · 对象存储 MinIO（compose profile 用；后端代码当前不读）
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=aioa
MINIO_ROOT_PASSWORD=DEV_ONLY__minio-local-pwd
MINIO_ACCESS_KEY=aioa
MINIO_SECRET_KEY=DEV_ONLY__minio-local-pwd
MINIO_ENDPOINT=http://127.0.0.1:9000

# ------------------------------------------------------------------------------
# 9 · 观测（compose profile=ops）
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# ==============================================================================
# 前端 env 不在本文件（vite 只读各应用自己的 .env）。见 deploy/ENV.md §4：
#   web/apps/shell/.env          VITE_PORT=5173 / VITE_API_TARGET=http://localhost:8080
#   web/apps/demo-ticket/.env    VITE_PORT=5174
#   web/apps/demo-dispatch/.env  VITE_PORT=5175
#   user-client/.env             PORT=5181 / BACKEND_HOST=127.0.0.1 / BACKEND_PORT=8080
# ==============================================================================
