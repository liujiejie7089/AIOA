{
  "name": "@aioa/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "AIOA 智能办公基座子应用接入 SDK（框架无关，基于 window.postMessage 与主应用通信）",
  "type": "module",
  "main": "./dist/aioa-sdk.cjs",
  "module": "./dist/aioa-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aioa-sdk.js",
      "require": "./dist/aioa-sdk.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
