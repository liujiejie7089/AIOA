<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.aioa</groupId>
    <artifactId>aioa-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>aioa-resource</artifactId>
  <name>aioa-resource</name>
  <description>用户端业务域：专家 / 技能 / 知识库 / 词元额度 / 词元账本 / 操作记录</description>

  <dependencies>
    <dependency>
      <groupId>cn.aioa</groupId>
      <artifactId>aioa-common</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.aioa</groupId>
      <artifactId>aioa-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 知识库文档解析：PDF / Word / Excel 文本抽取（FR-F1 文件上传入库） -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.3.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-scratchpad</artifactId>
      <version>5.3.0</version>
    </dependency>

    <!-- 向量库 Milvus（docs/32 / aioa.kb.store=milvus 时启用）。
         注意：本依赖会被打进 fat-jar（约 +17MB），但 mysql 档位下相关 Bean 全部不装配。 -->
    <dependency>
      <groupId>io.milvus</groupId>
      <artifactId>milvus-sdk-java</artifactId>
    </dependency>

    <!-- 单测：Milvus 过滤表达式 / RRF 融合 / HTTP 嵌入解析等纯逻辑（无 Spring 上下文、无真实 Milvus） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
