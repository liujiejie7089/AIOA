<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>cn.aioa</groupId>
  <artifactId>aioa-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>aioa-server</name>
  <description>AIOA 智能办公基座 · Java 后端（多模块）</description>

  <modules>
    <module>aioa-common</module>
    <module>aioa-security</module>
    <module>aioa-admin</module>
    <module>aioa-bridge</module>
    <module>aioa-chat</module>
    <module>aioa-tool-sdk</module>
    <module>aioa-boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <jjwt.version>0.12.6</jjwt.version>
    <springdoc.version>2.6.0</springdoc.version>
    <lombok.version>1.18.34</lombok.version>
  </properties>

  <dependencies>
    <!-- 全局依赖：Lombok 供所有模块编译期注解处理使用（版本由 Spring Boot parent 统一管理亦可，这里显式声明） -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-admin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-bridge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-chat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-tool-sdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis</artifactId>
        <version>3.5.16</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
