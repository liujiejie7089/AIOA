<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>aioa-tool-sdk</artifactId>
    <name>aioa-tool-sdk</name>
    <description>工具接入 SDK 契约：注解声明 + 自动注册（服务内工具，免 HTTP 中转）</description>

    <dependencies>
        <dependency>
            <groupId>cn.aioa</groupId>
            <artifactId>aioa-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 扫描注解需要 Spring 容器上下文（Bean 枚举 / AOP 目标类判定）。
             刻意不引 spring-security：SDK 保持领域中立，调用者身份以
             ToolCallContext 这一朴素载体传入，谁用谁转换。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
