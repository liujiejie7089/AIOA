<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.aioa</groupId>
        <artifactId>aioa-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>aioa-integration-scfy</artifactId>
    <name>aioa-integration-scfy</name>
    <description>
        非遗四川 2023（scfy）只读接入适配器 —— 契约 / 校验 / 工具。
        独立可插拔：整模块由 aioa.integration.scfy.enabled 开关控制，关掉即完全不存在，
        不残留 Bean、不注册工具；不改被接入系统任何代码。
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.aioa</groupId>
            <artifactId>aioa-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 工具契约：@AioaTool 注解 + ToolCallContext。
             SDK 只提供声明能力，治理（权限/审批/审计）由基座网关统一执行。 -->
        <dependency>
            <groupId>cn.aioa</groupId>
            <artifactId>aioa-tool-sdk</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 只为 @ConditionalOnProperty / @ConfigurationProperties 这层装配开关，
             不引 spring-boot-starter-web：适配器不做 Controller，不占端口。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 刻意不引 HTTP 客户端库：用 JDK 内置 java.net.http.HttpClient，
             与 common/http/AgentHttpClient 口径一致（避免明文目标的 H2C 升级坑）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
